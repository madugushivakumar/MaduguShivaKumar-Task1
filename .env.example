# ==============================================================================
# Joineazy System Environment Variables (.env.example)
# Copy this file to .env (or backend/.env and frontend/.env) for local configuration.
# Never commit actual secret values or credentials to version control.
# ==============================================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Configuration
DB_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=joineazy_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/joineazy_db

# Security & Authentication (JWT)
# IMPORTANT: Generate a cryptographically secure key for production (e.g. openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS & Web Client Configuration
FRONTEND_URL=http://localhost:5173

# Frontend Environment Variables (Vite client)
VITE_API_URL=http://localhost:5000/api
